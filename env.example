# Segredos do "ideias". Copie para ~/.config/ideias/env e preencha.
# Proteja o arquivo: chmod 600 ~/.config/ideias/env
# Variáveis de ambiente com o mesmo nome têm prioridade sobre este arquivo.

# Bluesky: crie um app password em Settings > Privacy and security > App passwords.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# GitHub: token fine-grained, só leitura de repositórios públicos basta.
GITHUB_TOKEN=

# OmniRoute (já roda no Termux; o ideias só consome a API).
# Padrão quando vazio: http://localhost:20128/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# Telegram: token do @BotFather e o ID do chat que recebe o relatório.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
